{
  "info": {
    "_postman_id": "7ef7a2be-1833-42f0-9da2-3cb7423e8877",
    "name": "Berry Care - Pengujian Login API",
    "description": "Koleksi pengujian POST /api/login dan autentikasi token. Jalankan request secara berurutan. Request pertama mendaftarkan akun lewat pm.sendRequest pada pre-request script lalu menguji login akun itu. Jalankan G paling akhir dan terpisah melalui Collection Runner sebanyak 7 iterasi; email limiter dibuat unik untuk setiap run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "variable": [
      { "key": "baseUrl", "value": "http://127.0.0.1:8000/api" },
      { "key": "testEmail", "value": "" },
      { "key": "testPassword", "value": "" },
      { "key": "registerToken", "value": "" },
      { "key": "token", "value": "" },
      { "key": "knownFailureBody", "value": "" },
      { "key": "rateLimitEmail", "value": "" }
    ]
  },
  "item": [
    {
      "name": "0. Register akun uji",
      "description": "Pre-request membuat email uji unik, mengirim POST /register dengan password_confirmation, lalu menyimpan email, password, dan token registrasi sebagai variabel koleksi. Request utama login ke akun baru tersebut untuk memastikan akun uji siap. Tidak memakai kredensial akun asli.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = 'uji_' + Date.now() + '@contoh.com';",
              "const password = 'Password123';",
              "pm.collectionVariables.set('testEmail', email);",
              "pm.collectionVariables.set('testPassword', password);",
              "pm.collectionVariables.unset('token');",
              "pm.collectionVariables.unset('registerToken');",
              "const registration = await pm.sendRequest({",
              "  url: pm.collectionVariables.get('baseUrl') + '/register',",
              "  method: 'POST',",
              "  header: { Accept: 'application/json', 'Content-Type': 'application/json' },",
              "  body: { mode: 'raw', raw: JSON.stringify({ name: 'Akun Uji Postman', email: email, password: password, password_confirmation: password }) }",
              "});",
              "if (registration.code !== 201) { throw new Error('Register akun uji gagal: HTTP ' + registration.code); }",
              "const registeredBody = registration.json();",
              "pm.collectionVariables.set('registerStatus', String(registration.code));",
              "pm.collectionVariables.set('registerToken', registeredBody.token);",
              "pm.collectionVariables.set('token', registeredBody.token);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Pre-request berhasil register dengan 201', function () { pm.expect(pm.collectionVariables.get('registerStatus')).to.eql('201'); });",
              "pm.test('Login akun uji hasil register menghasilkan 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Respons login memiliki message, user, dan token tanpa password', function () {",
              "  pm.expect(body).to.have.property('message');",
              "  pm.expect(body.user).to.include.all.keys('id', 'name', 'email', 'role');",
              "  pm.expect(body.user).not.to.have.property('password');",
              "  pm.expect(body).to.have.property('token').that.is.a('string');",
              "});",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "A. Login berhasil",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status login sukses adalah 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Respons sukses berisi message, user, dan token tanpa password', function () {",
              "  pm.expect(body).to.have.property('message', 'Login berhasil.');",
              "  pm.expect(body.user).to.include.all.keys('id', 'name', 'email', 'role');",
              "  pm.expect(body.user).not.to.have.property('password');",
              "  pm.expect(body).to.have.property('token').that.is.a('string');",
              "});",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ],
