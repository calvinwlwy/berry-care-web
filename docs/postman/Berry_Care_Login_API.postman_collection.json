    {
      "name": "I. Input berbahaya dan password sangat panjang",
      "description": "Request utama mengirim email mirip SQL injection. Tab Tests juga menguji password 10.000 karakter dengan email akun uji yang valid.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('longPassword', 'x'.repeat(10000));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Email berisi input mirip SQL tidak menghasilkan 500', function () {",
              "  pm.expect([401, 422]).to.include(pm.response.code);",
              "  pm.expect(pm.response.code).not.to.equal(500);",
              "  pm.expect(pm.response.json()).to.have.property('message');",
              "});",
              "const base = pm.collectionVariables.get('baseUrl');",
              "const longPassword = pm.collectionVariables.get('longPassword');",
              "pm.sendRequest({",
              "  url: base + '/login', method: 'POST',",
              "  header: { Accept: 'application/json', 'Content-Type': 'application/json' },",
              "  body: { mode: 'raw', raw: JSON.stringify({ email: pm.collectionVariables.get('testEmail'), password: longPassword }) }",
              "}, function (error, response) {",
              "  pm.test('Password 10.000 karakter tidak menghasilkan 500', function () {",
              "    pm.expect(error).to.equal(null); pm.expect([401, 422]).to.include(response.code);",
              "    pm.expect(response.code).not.to.equal(500); pm.expect(response.json()).to.have.property('message');",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
