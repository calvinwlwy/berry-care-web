    {
      "name": "G. Rate limit login - jalankan terakhir, 7 iterasi",
      "description": "Buka Collection Runner, pilih koleksi ini dan jalankan request G saja sebanyak 7 iterasi. Iterasi 1-5 harus menerima 401; iterasi 6-7 harus 429 dengan Retry-After. Email dibuat unik pada iterasi pertama. Gunakan cache limiter yang sama dengan aplikasi (default database); jangan jalankan request ini lebih dari sekali dalam satu menit untuk email yang sama.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.info.iteration === 0 || !pm.collectionVariables.get('rateLimitEmail')) {",
              "  pm.collectionVariables.set('rateLimitEmail', 'ratelimit_' + Date.now() + '@contoh.com');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (pm.info.iteration < 5) {",
              "  pm.test('Lima percobaan pertama ditolak sebagai kredensial salah (401)', function () {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(body).to.eql({ message: 'Email atau password salah' });",
              "    pm.expect(body).not.to.have.property('token');",
              "  });",
              "} else {",
              "  pm.test('Percobaan setelah batas menjadi 429 dengan Retry-After', function () {",
              "    pm.response.to.have.status(429);",
              "    pm.expect(body.message).to.eql('Terlalu banyak percobaan login. Silakan coba lagi dalam satu menit.');",
              "    pm.expect(pm.response.headers.get('Retry-After')).to.exist;",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{rateLimitEmail}}\",\n  \"password\": \"PasswordSalah123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/login"
      }
    }
  ]
}
