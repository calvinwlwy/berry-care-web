    {
      "name": "E. GET user dengan dan tanpa token",
      "description": "Request utama memakai token valid dan harus 200. Tab Tests juga mengirim dua subrequest: tanpa Authorization dan dengan token palsu; keduanya harus 401 JSON.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Token valid menghasilkan 200 dan data profil tanpa password', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.user).to.include.all.keys('id', 'name', 'email', 'role');",
              "  pm.expect(body.user).not.to.have.property('password');",
              "});",
              "const base = pm.collectionVariables.get('baseUrl');",
              "pm.sendRequest({ url: base + '/user', method: 'GET', header: { Accept: 'application/json' } }, function (error, response) {",
              "  pm.test('Tanpa token menghasilkan 401 JSON', function () {",
              "    pm.expect(error).to.equal(null); pm.expect(response.code).to.equal(401);",
              "    pm.expect(response.headers.get('Content-Type')).to.include('application/json');",
              "    pm.expect(response.json()).to.eql({ message: 'Tidak terautentikasi.' });",
              "  });",
              "});",
              "pm.sendRequest({ url: base + '/user', method: 'GET', header: { Accept: 'application/json', Authorization: 'Bearer token-palsu' } }, function (error, response) {",
              "  pm.test('Token palsu menghasilkan 401 JSON', function () {",
              "    pm.expect(error).to.equal(null); pm.expect(response.code).to.equal(401);",
              "    pm.expect(response.json()).to.eql({ message: 'Tidak terautentikasi.' });",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/user"
      }
    },
