# Copy to .env on the production server and fill all required values.
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=warning
APP_URL=https://contoh-domain

# Comma-separated IP/CIDR values of the hosting reverse proxy; leave empty if none.
TRUSTED_PROXIES=

# Cookies must only be sent over HTTPS.
SESSION_SECURE_COOKIE=true

# Public registration is disabled by default in production.
API_REGISTRATION_ENABLED=false

# Comma-separated exact origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=

# Google OAuth credentials and callback registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ALLOWED_DOMAIN=
# Keep disabled in production. Register users through an approved admin process.
GOOGLE_AUTO_REGISTER=false

# Sanctum token lifetime: 10080 minutes (7 days).
SANCTUM_EXPIRATION=10080

# Configure these privately on the server; never commit real credentials.
ADMIN_EMAIL=admin@berrycare.test
ADMIN_PASSWORD=
